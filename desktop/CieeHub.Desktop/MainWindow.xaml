<Window x:Class="CieeHub.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="CIEE Hub Desktop" Height="820" Width="1400" MinHeight="700" MinWidth="1100"
        Background="#0F172A" Foreground="White">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#111827" Padding="18">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Top">
                    <TextBlock Text="CIEE HUB DESKTOP" FontSize="22" FontWeight="Bold" Margin="0,0,0,6"/>
                    <TextBlock Text="MVP • WebView2" Foreground="#94A3B8" Margin="0,0,0,18"/>

                    <Border Background="#172033" CornerRadius="8" Padding="12" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="STATUS" FontSize="11" Foreground="#94A3B8"/>
                            <TextBlock x:Name="StatusText" Text="Inicializando..." FontWeight="SemiBold" Margin="0,4,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <Button x:Name="OpenKairosButton" Content="Abrir Kairós" Height="42" Margin="0,0,0,8" Click="OpenKairosButton_Click"/>
                    <Button x:Name="OpenZendeskButton" Content="Abrir Zendesk" Height="42" Margin="0,0,0,8" Click="OpenZendeskButton_Click"/>
                    <Button x:Name="OpenTalentosButton" Content="Abrir Talentos" Height="42" Margin="0,0,0,18" Click="OpenTalentosButton_Click"/>

                    <Separator Margin="0,0,0,16"/>

                    <Button x:Name="InjectBridgeButton" Content="Injetar ponte JS" Height="42" Margin="0,0,0,8" Click="InjectBridgeButton_Click"/>
                    <Button x:Name="ProbePageButton" Content="Diagnosticar página atual" Height="42" Margin="0,0,0,8" Click="ProbePageButton_Click"/>
                    <Button x:Name="StopAutomationButton" Content="Parar automação" Height="42" Click="StopAutomationButton_Click"/>
                </StackPanel>

                <Border DockPanel.Dock="Bottom" Background="#0B1220" CornerRadius="8" Padding="10" Margin="0,18,0,0">
                    <TextBlock Text="Nesta fase o Desktop só conecta, navega, injeta a ponte e recebe eventos. As automações 4.1.4 entram por módulos." Foreground="#94A3B8" TextWrapping="Wrap" FontSize="11"/>
                </Border>
            </DockPanel>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="52"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="180"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="#172033" Padding="12,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="AddressBox" VerticalContentAlignment="Center" FontSize="13" Margin="0,0,8,0" KeyDown="AddressBox_KeyDown"/>
                    <Button Grid.Column="1" Content="Ir" Width="70" Click="GoButton_Click"/>
                </Grid>
            </Border>

            <wv2:WebView2 x:Name="Browser" Grid.Row="1"/>

            <Border Grid.Row="2" Background="#020617" BorderBrush="#243044" BorderThickness="0,1,0,0" Padding="10">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="LOG DO HUB" FontWeight="Bold" Foreground="#93C5FD" Margin="0,0,0,8"/>
                    <TextBox x:Name="LogBox" IsReadOnly="True" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Background="#020617" Foreground="#CBD5E1" BorderThickness="0" FontFamily="Consolas" FontSize="12" TextWrapping="NoWrap"/>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
